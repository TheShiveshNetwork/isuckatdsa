---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ArrowRight, Command } from "@lucide/astro";
import { Kbd, KbdGroup } from "@/components/ui/kbd";
import { SITE } from "@/lib/site-config";
import { getCategorizedNotes } from "@/lib/wiki/get-categorized-notes";
import NoteCard from "@/components/wiki/NoteCard.astro";

const categories = await getCategorizedNotes();
---

<BaseLayout title={SITE.siteName} description={SITE.description}>
  <main class="mx-auto max-w-5xl px-4 py-16 md:py-24" data-pagefind-body>
    <header class="mb-16">
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">
        i suck at dsa <span class="line-through">no more</span>.
      </h1>
      <p class="mt-3 text-muted-foreground">
        A wiki of DSA mental models, patterns, and algorithms ...for people who
        suck at dsa.
      </p>
      <p
        class="mt-3 inline-flex flex-nowrap items-center gap-2 whitespace-nowrap text-sm text-muted-foreground"
      >
        <span class="shrink-0 text-muted-foreground">Press</span>
        <KbdGroup
          class="mx-1 inline-flex shrink-0 items-center gap-1 align-middle"
        >
          <Kbd><Command class="size-3" /></Kbd>
          <span class="text-muted-foreground">+</span>
          <Kbd>K</Kbd>
        </KbdGroup>
        <span class="shrink-0 text-muted-foreground">anytime to search.</span>
      </p>
    </header>

    {
      categories.map(({ name, notes }) => (
        <section class="mb-14">
          <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-muted-foreground">
            {name} &middot; {notes.length}{" "}
            {notes.length === 1 ? "note" : "notes"}
          </h2>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {notes.map((note) => (
              <NoteCard
                id={note.id}
                title={note.title}
                description={note.description}
                growthStage={note.growthStage}
              />
            ))}
          </div>
        </section>
      ))
    }

    <footer class="flex justify-center">
      <a
        href="/tags"
        class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        Browse tags
        <ArrowRight class="size-4" />
      </a>
    </footer>
  </main>
</BaseLayout>

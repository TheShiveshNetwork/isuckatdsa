---
/**
 * @component WikiPagination
 * @title WikiPagination
 * @description Prev / next chapter navigation shown at the bottom of a wiki note.
 */

import { ArrowLeft, ArrowRight } from "@lucide/astro";
import { Separator } from "@/components/ui/separator";

export interface WikiPageRef {
  href: string;
  title: string;
}

interface Props {
  prev?: WikiPageRef;
  next?: WikiPageRef;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="mt-12" aria-label="Chapter navigation">
      <Separator class="mb-6" />
      <div
        class:list={[
          "flex flex-col gap-3 sm:flex-row",
          prev ? "sm:justify-between" : "sm:justify-end",
        ]}
      >
        {prev && (
          <a
            href={prev.href}
            class="group flex w-full flex-1 flex-col gap-1 rounded-lg border border-border bg-background px-4 py-3 transition-colors hover:bg-muted"
          >
            <span class="flex items-center gap-1 text-xs text-muted-foreground">
              <ArrowLeft class="size-3.5 transition-transform group-hover:-translate-x-0.5" />
              Previous
            </span>
            <span class="font-medium text-foreground">{prev.title}</span>
          </a>
        )}
        {next && (
          <a
            href={next.href}
            class="group flex w-full flex-1 flex-col gap-1 rounded-lg border border-border bg-background px-4 py-3 transition-colors hover:bg-muted"
          >
            <span
              class:list={[
                "flex items-center gap-1 text-xs text-muted-foreground",
                !prev && "justify-end",
              ]}
            >
              Next
              <ArrowRight class="size-3.5 transition-transform group-hover:translate-x-0.5" />
            </span>
            <span class="font-medium text-foreground">{next.title}</span>
          </a>
        )}
      </div>
    </nav>
  )
}

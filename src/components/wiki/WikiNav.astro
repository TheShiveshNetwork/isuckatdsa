---
import { getCollection } from "astro:content";
import WikiNavNode from "./WikiNavNode.astro";
import { buildWikiTree, sortTreeNodes } from "@/lib/wiki/tree-utils";

const allNotes = await getCollection("wiki");
const currentPath = Astro.url.pathname.replace(/\/$/, "");

const root = buildWikiTree(allNotes);
const sortedRootKeys = sortTreeNodes(root);
---

<nav class="space-y-0.5">
  {
    sortedRootKeys.map((key) => (
      <WikiNavNode
        node={root[key]}
        depth={0}
        currentPath={currentPath}
        class="pb-4"
      />
    ))
  }
</nav>
